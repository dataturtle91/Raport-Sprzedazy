library(ggiraph)
df <- mtcars
plot <- df %>% mutate(vs = as.factor(vs),
car = row.names(df)) %>%
ggplot(aes(x = mpg, y = disp, col = vs)) +
geom_point_interactive(
aes(
tooltip = paste(car,"<br>mpg: <strong>", mpg,"</strong>",
"<br>disp: <strong>",disp,"</strong>",
"<br>vs:",vs)
), shape = 19, position = position_jitter(width = 0.5, height = 0.5), alpha = 0.6) +
theme_minimal() +
scale_color_discrete(
name = "engine type",
labels =  c(
"0" = "V-shaped",
"1" = "Straight"
)
)
girafe(ggobj = plot)
