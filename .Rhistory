library(tidyverse)
library(tidyverse)
die <- c(1:6)
mean(die)
library(tidyverse)
die <- c(1:6)
set.seed(123)
rolls_10 <- die %>%
sample_n(10, replace = TRUE)
library(tidyverse)
as.dataframe(die) <- c(1:6)
library(tidyverse)
die <- c(1:6)
die <- as.data.frame(die)
set.seed(123)
rolls_10 <- die %>%
sample_n(10, replace = TRUE)
rolls_10
mean(rolls_10)
mean(rolls_10$die)
library(tidyverse)
die <- c(1:6)
die <- as.data.frame(die)
set.seed(123)
rolls_10$n <- die %>%
sample_n(10, replace = TRUE)
View(rolls_10)
